# Exact dashboard origin allowed to call the API. The production MVP requires
# one public HTTPS dashboard origin; this is distinct from the automated site.
DOONCE_ALLOWED_ORIGINS=http://localhost:3000
# Exact installed extension origin. Production MVP requires exactly one final ID.
DOONCE_EXTENSION_ORIGINS=

# Bind locally by default. Set explicitly in a trusted deployment environment.
HOST=127.0.0.1
PORT=4000

# PostgreSQL is required for accounts, tenant-scoped workflow storage and receipts.
# Runtime uses the non-superuser role so PostgreSQL RLS cannot be bypassed.
DATABASE_URL=postgres://doonce_app:doonce-app-dev-password@127.0.0.1:5432/doonce
# Migrations use the schema-owner role. Do not use this URL for the API process.
MIGRATIONS_DATABASE_URL=postgres://doonce:doonce-dev-password@127.0.0.1:5432/doonce
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
# Optional durable worker connection. Use a role limited to the pg-boss schema;
# do not reuse the tenant application role or migration owner in production.
JOB_DATABASE_URL=postgres://doonce_jobs:replace-me@127.0.0.1:5432/doonce
# Required only on worker hosts that execute managed browser runs.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Chromium\chrome.exe
# Default deny. Populate only with reviewed, expiring qualification records whose
# workflow checksum, exact domain, browser image digest, and drill evidence match.
HOSTED_QUALIFICATIONS_JSON=[]
DOONCE_WORKFLOW_CHANGES_ENABLED=true
DOONCE_KILL_SWITCH=false
# The production pilot enables MVP mode and must supply one exact public HTTPS
# origin without a path. This is the automated report site, not the dashboard
# CORS origin. Invite-only signup is mandatory in MVP mode.
DOONCE_MVP_MODE=false
DOONCE_PILOT_ALLOWED_ORIGIN=https://reports.example.com
# Keep false in persistent environments. Enable only for the one-shot operator CLI.
DOONCE_INVITATION_CREATION_ENABLED=false

# Optional workflow authoring and repair modules.
TEXT_AUTHORING_ENABLED=false
REPAIR_ENABLED=false
VIDEO_AUTHORING_ENABLED=false
VIDEO_STORAGE_PATH=./var/videos
ARTIFACT_STORAGE_PATH=./var/artifacts
ARTIFACT_SIGNING_SECRET=replace-with-an-independent-random-32-byte-secret

# Media tools. Container defaults are on PATH; set absolute paths on managed hosts.
FFPROBE_EXECUTABLE_PATH=ffprobe
FFMPEG_EXECUTABLE_PATH=ffmpeg
TESSERACT_EXECUTABLE_PATH=tesseract

# Internal observability. The metrics token must be independent from session secrets.
METRICS_BEARER_TOKEN=replace-with-an-independent-random-monitoring-token
OTEL_SERVICE_NAME=doonce-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Immutable deployment identity. Every field is required in production MVP mode
# and is persisted with each run for receipt provenance.
DOONCE_DEPLOYMENT_ID=
DOONCE_ENVIRONMENT=
DOONCE_BACKEND_COMMIT=
DOONCE_FRONTEND_COMMIT=
DOONCE_BACKEND_IMAGE_DIGEST=
DOONCE_FRONTEND_IMAGE_DIGEST=
DOONCE_EXTENSION_ID=
DOONCE_EXTENSION_VERSION=0.4.0
DOONCE_EXTENSION_PACKAGE_SHA256=
DOONCE_PROTOCOL_SCHEMA_SHA256=
DOONCE_MIGRATION_SET_SHA256=
