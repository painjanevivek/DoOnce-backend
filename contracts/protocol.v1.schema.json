{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doonce.dev/schemas/protocol.v1.schema.json",
  "title": "DoOnce protocol contracts v1",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "domain": {
      "anyOf": [
        { "enum": ["localhost", "127.0.0.1"] },
        { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$" }
      ]
    },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/(?!/)(?!.*\\.\\.).*$" },
    "LocatorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value", "confidence"],
      "properties": {
        "strategy": { "enum": ["id", "capture-id", "role", "label", "text"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "LocatorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "primary", "fallbacks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "primary": { "$ref": "#/$defs/LocatorCandidate" },
        "fallbacks": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/LocatorCandidate" } }
      }
    },
    "PageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "origin", "path", "urlPattern", "navigationId"],
      "properties": {
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
        "path": { "$ref": "#/$defs/relativePath" },
        "urlPattern": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "navigationId": { "$ref": "#/$defs/uuid" },
        "titleHint": { "type": "string", "minLength": 1, "maxLength": 160 },
        "domFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" }
      }
    },
    "ElementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagName", "framePath", "domFingerprint", "visibility", "locator"],
      "properties": {
        "role": { "type": "string", "minLength": 1, "maxLength": 80 },
        "accessibleName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "testId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tagName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "inputType": { "type": "string", "minLength": 1, "maxLength": 40 },
        "textHint": { "type": "string", "minLength": 1, "maxLength": 160 },
        "cssCandidate": { "type": "string", "minLength": 1, "maxLength": 256 },
        "framePath": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "domFingerprint": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "visibility": {
          "type": "object", "additionalProperties": false, "required": ["inViewport", "ratio", "viewportWidth", "viewportHeight"],
          "properties": { "inViewport": { "type": "boolean" }, "ratio": { "type": "number", "minimum": 0, "maximum": 1 }, "viewportWidth": { "type": "integer", "minimum": 0, "maximum": 20000 }, "viewportHeight": { "type": "integer", "minimum": 0, "maximum": 20000 } }
        },
        "locator": { "$ref": "#/$defs/LocatorSpec" }
      }
    },
    "CapturedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "placeholder", "length"],
      "properties": {
        "classification": { "enum": ["literal-candidate", "variable-candidate", "secret-placeholder", "intentionally-omitted"] },
        "placeholder": { "type": "string", "minLength": 1, "maxLength": 80 },
        "length": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "PageTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "path"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "ElementTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "path", "locator"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "path": { "$ref": "#/$defs/relativePath" },
        "locator": { "$ref": "#/$defs/LocatorSpec" }
      }
    },
    "WorkflowInputDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "kind", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["text", "date", "select"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "defaultValue": { "type": "string", "maxLength": 1000 },
        "secret": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "select" } }, "required": ["kind"] }, "then": { "properties": { "options": true }, "required": ["options"] }, "else": { "not": { "required": ["options"] } } }
      ]
    },
    "WorkflowAssertion": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "operator", "expected"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "url-match" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 2048 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "target"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "enum": ["element-present", "element-absent"] }, "target": { "$ref": "#/$defs/ElementTarget" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "target", "operator", "expected"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "text-match" }, "target": { "$ref": "#/$defs/ElementTarget" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 1000 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "target", "operator", "expected"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "field-state" }, "target": { "$ref": "#/$defs/ElementTarget" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 1000 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "file-downloaded" }, "fileNamePattern": { "type": "string", "maxLength": 240 }, "contentTypes": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$", "maxLength": 120 } }, "minBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }, "maxBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "outputName", "operator", "expected"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "extracted-value" }, "outputName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 1000 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "target", "operator", "count"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "table-row-count" }, "target": { "$ref": "#/$defs/ElementTarget" }, "operator": { "enum": ["equals", "at-least", "at-most"] }, "count": { "type": "integer", "minimum": 0, "maximum": 1000000 } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "prompt"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "const": "user-confirmation" }, "prompt": { "type": "string", "minLength": 1, "maxLength": 240 } } }
      ]
    },
    "AssertionResult": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "assertionId", "status", "verifiedAt"],
      "properties": { "schemaVersion": { "const": 1 }, "assertionId": { "$ref": "#/$defs/uuid" }, "status": { "enum": ["verified", "failed", "confirmation-required"] }, "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" }, "observed": { "type": "string", "maxLength": 1000 }, "evidenceRefs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "verifiedAt": { "$ref": "#/$defs/timestamp" } }
    },
    "StepBase": {
      "type": "object",
      "required": ["id", "action", "name", "expectedOutcome"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "action": { "enum": ["navigate", "wait", "read", "select", "type", "download", "compare", "branch", "ask-approval", "stop"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 240 },
        "assertions": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/WorkflowAssertion" } }
      }
    },
    "NavigateStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target"], "properties": { "action": { "const": "navigate" }, "target": { "$ref": "#/$defs/PageTarget" } } }
      ],
      "unevaluatedProperties": false
    },
    "WaitStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target", "timeoutMs"], "properties": { "action": { "const": "wait" }, "target": { "$ref": "#/$defs/ElementTarget" }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 } } }
      ],
      "unevaluatedProperties": false
    },
    "ReadStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target", "outputName"], "properties": { "action": { "const": "read" }, "target": { "$ref": "#/$defs/ElementTarget" }, "outputName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } }
      ],
      "unevaluatedProperties": false
    },
    "SelectStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target", "inputName"], "properties": { "action": { "const": "select" }, "target": { "$ref": "#/$defs/ElementTarget" }, "inputName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } }
      ],
      "unevaluatedProperties": false
    },
    "TypeStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target", "inputName"], "properties": { "action": { "const": "type" }, "target": { "$ref": "#/$defs/ElementTarget" }, "inputName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } } }
      ],
      "unevaluatedProperties": false
    },
    "DownloadStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target"], "properties": { "action": { "const": "download" }, "target": { "$ref": "#/$defs/ElementTarget" } } }
      ],
      "unevaluatedProperties": false
    },
    "CompareStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["target", "operator", "expected"], "properties": { "action": { "const": "compare" }, "target": { "$ref": "#/$defs/ElementTarget" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 1000 } } }
      ],
      "unevaluatedProperties": false
    },
    "BranchStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["inputName", "operator", "expected", "ifTrueStepId"], "properties": { "action": { "const": "branch" }, "inputName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }, "operator": { "enum": ["equals", "contains", "matches"] }, "expected": { "type": "string", "maxLength": 1000 }, "ifTrueStepId": { "$ref": "#/$defs/uuid" }, "ifFalseStepId": { "$ref": "#/$defs/uuid" } } }
      ],
      "unevaluatedProperties": false
    },
    "ApprovalStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["prompt"], "properties": { "action": { "const": "ask-approval" }, "prompt": { "type": "string", "minLength": 1, "maxLength": 240 } } }
      ],
      "unevaluatedProperties": false
    },
    "StopStep": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/StepBase" },
        { "type": "object", "required": ["reason"], "properties": { "action": { "const": "stop" }, "reason": { "type": "string", "minLength": 1, "maxLength": 240 } } }
      ],
      "unevaluatedProperties": false
    },
    "WorkflowStep": {
      "oneOf": [
        { "$ref": "#/$defs/NavigateStep" }, { "$ref": "#/$defs/WaitStep" }, { "$ref": "#/$defs/ReadStep" },
        { "$ref": "#/$defs/SelectStep" }, { "$ref": "#/$defs/TypeStep" }, { "$ref": "#/$defs/DownloadStep" },
        { "$ref": "#/$defs/CompareStep" }, { "$ref": "#/$defs/BranchStep" }, { "$ref": "#/$defs/ApprovalStep" }, { "$ref": "#/$defs/StopStep" }
      ]
    },
    "WorkflowSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "format", "title", "allowedDomains", "inputs", "steps"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "format": { "const": "doonce.workflow-spec.v1" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "allowedDomains": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/domain" } },
        "inputs": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/WorkflowInputDefinition" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/WorkflowStep" } },
        "successCriteria": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/WorkflowAssertion" } }
      }
    },
    "RuntimeCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "executor", "actions", "maxSteps", "supportsDownloads"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "executor": { "enum": ["extension", "hosted-browser"] },
        "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["navigate", "wait", "read", "select", "type", "download", "compare", "branch", "ask-approval", "stop"] } },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "supportsDownloads": { "type": "boolean" }
      }
    },
    "RecordedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "sequence", "occurredAt", "origin", "path", "eventKind"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/uuid" },
        "sequence": { "type": "integer", "minimum": 0 },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
        "path": { "$ref": "#/$defs/relativePath" },
        "eventKind": { "enum": ["click", "change", "input", "select", "toggle", "submit", "navigate", "reload", "redirect", "download", "download-start", "download-complete", "tab-create", "tab-switch", "wait-transition"] },
        "locator": { "$ref": "#/$defs/LocatorSpec" },
        "actionHint": { "enum": ["download"] },
        "target": { "$ref": "#/$defs/ElementEvidence" },
        "value": { "$ref": "#/$defs/CapturedValue" },
        "before": { "$ref": "#/$defs/PageState" },
        "after": { "$ref": "#/$defs/PageState" },
        "tabId": { "type": "integer", "minimum": 0 },
        "frameId": { "type": "integer", "minimum": 0 }
      }
    },
    "CaptureSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "format", "id", "startedAt", "status", "approvedOrigins", "actions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "format": { "const": "doonce.capture-session.v1" },
        "id": { "$ref": "#/$defs/uuid" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "endedAt": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["recording", "paused", "stopped", "synchronizing", "finalized", "discarded", "completed"] },
        "approvedOrigins": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "actions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/RecordedAction" } },
        "extensionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "syncCursor": { "type": "integer", "minimum": -1 },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "CaptureSessionSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "status", "startedAt", "actionCount"],
      "properties": {
        "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/uuid" },
        "status": { "enum": ["recording", "finalized", "discarded"] }, "startedAt": { "$ref": "#/$defs/timestamp" }, "endedAt": { "$ref": "#/$defs/timestamp" },
        "actionCount": { "type": "integer", "minimum": 0, "maximum": 1000 }, "workflowId": { "$ref": "#/$defs/uuid" },
        "compilerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 }
      }
    },
    "CaptureHandshake": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "extensionVersion", "capabilities", "maxBatchSize"],
      "properties": {
        "schemaVersion": { "const": 1 }, "extensionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["semantic-elements", "frames", "shadow-dom", "navigation", "downloads", "tabs", "offline-buffer"] } },
        "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "CaptureSyncRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sessionId", "batchId", "cursor", "actions", "final"],
      "properties": {
        "schemaVersion": { "const": 1 }, "sessionId": { "$ref": "#/$defs/uuid" }, "batchId": { "$ref": "#/$defs/uuid" },
        "cursor": { "type": "integer", "minimum": -1 }, "actions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/RecordedAction" } }, "final": { "type": "boolean" }
      }
    },
    "CaptureSyncAck": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sessionId", "batchId", "acceptedThrough", "status"],
      "properties": {
        "schemaVersion": { "const": 1 }, "sessionId": { "$ref": "#/$defs/uuid" }, "batchId": { "$ref": "#/$defs/uuid" },
        "acceptedThrough": { "type": "integer", "minimum": -1 }, "status": { "enum": ["accepted", "duplicate", "finalized"] }, "retryAfterMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "CompilerWarning": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "message", "actionIds"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,79}$" }, "severity": { "enum": ["warning", "error"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actionIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "FieldProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source", "confidence", "actionIds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/workflow(?:/.*)?$", "maxLength": 500 },
        "source": { "enum": ["observed", "deterministically-inferred", "ai-suggested", "manually-edited"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "actionIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "ActionCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["actionId", "outcome", "stepIds"],
      "properties": {
        "actionId": { "$ref": "#/$defs/uuid" }, "outcome": { "enum": ["emitted", "combined", "unsupported"] },
        "stepIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "AuthoringSuggestion": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "value", "confidence", "reason", "actionIds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/workflow(?:/.*)?$", "maxLength": 500 }, "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actionIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "WorkflowCompilation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "format", "compilerVersion", "captureSessionId", "sourceDigest", "workflow", "warnings", "provenance", "coverage", "suggestions"],
      "properties": {
        "schemaVersion": { "const": 1 }, "format": { "const": "doonce.workflow-compilation.v1" },
        "compilerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 }, "captureSessionId": { "$ref": "#/$defs/uuid" },
        "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "workflow": { "$ref": "#/$defs/WorkflowSpec" },
        "warnings": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/CompilerWarning" } },
        "provenance": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/FieldProvenance" } },
        "coverage": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/ActionCoverage" } },
        "suggestions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/AuthoringSuggestion" } }
      }
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "workflowId", "workflowVersion", "executor", "inputs", "requestedAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "runId": { "$ref": "#/$defs/uuid" }, "workflowId": { "$ref": "#/$defs/uuid" },
        "workflowVersion": { "type": "integer", "minimum": 1 }, "executor": { "enum": ["extension", "hosted-browser"] },
        "inputs": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 10000 } }, "requestedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "StepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "stepId", "status", "startedAt", "finishedAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "stepId": { "$ref": "#/$defs/uuid" }, "status": { "enum": ["verified", "paused", "failed", "skipped"] },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" }, "startedAt": { "$ref": "#/$defs/timestamp" }, "finishedAt": { "$ref": "#/$defs/timestamp" },
        "selectedLocator": { "$ref": "#/$defs/LocatorCandidate" }, "locatorConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "outputs": { "type": "object", "maxProperties": 100, "additionalProperties": { "type": "string", "maxLength": 10000 } },
        "evidenceRefs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 10 }, "observedPage": { "$ref": "#/$defs/PageState" },
        "repairCandidates": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/LocatorCandidate" } },
        "assertionResults": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/AssertionResult" } }
      }
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "format", "runId", "workflowId", "workflowVersion", "status", "stepResults", "startedAt", "finishedAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "format": { "const": "doonce.run-result.v1" }, "runId": { "$ref": "#/$defs/uuid" }, "workflowId": { "$ref": "#/$defs/uuid" },
        "workflowVersion": { "type": "integer", "minimum": 1 }, "status": { "enum": ["completed", "paused", "failed", "cancelled"] },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" }, "stepResults": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/StepResult" } },
        "startedAt": { "$ref": "#/$defs/timestamp" }, "finishedAt": { "$ref": "#/$defs/timestamp" },
        "assertionResults": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/AssertionResult" } }
      }
    },
    "RepairOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "stepId", "reason"],
      "properties": {
        "op": { "enum": ["replace-locator", "update-expected-outcome"] }, "stepId": { "$ref": "#/$defs/uuid" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "locator": { "$ref": "#/$defs/LocatorSpec" }, "expectedOutcome": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "replace-locator" } }, "required": ["op"] }, "then": { "properties": { "locator": true, "expectedOutcome": false }, "required": ["locator"] }, "else": { "properties": { "expectedOutcome": true, "locator": false }, "required": ["expectedOutcome"] } }
      ]
    },
    "RepairProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "format", "id", "workflowId", "baseVersion", "createdAt", "operations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "format": { "const": "doonce.repair-proposal.v1" }, "id": { "$ref": "#/$defs/uuid" }, "workflowId": { "$ref": "#/$defs/uuid" },
        "baseVersion": { "type": "integer", "minimum": 1 }, "createdAt": { "$ref": "#/$defs/timestamp" }, "operations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/RepairOperation" } }
      }
    },
    "ExtensionMessage": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "sessionId"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "capture.start" }, "sessionId": { "$ref": "#/$defs/uuid" } } },
        { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "sessionId"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "capture.stop" }, "sessionId": { "$ref": "#/$defs/uuid" } } },
        { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "action"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "capture.action" }, "action": { "$ref": "#/$defs/RecordedAction" } } },
        { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "request"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "run.start" }, "request": { "$ref": "#/$defs/RunRequest" } } },
        { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "type", "result"], "properties": { "schemaVersion": { "const": 1 }, "type": { "const": "run.result" }, "result": { "$ref": "#/$defs/RunResult" } } }
      ]
    },
    "ApiError": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "error"],
      "properties": { "schemaVersion": { "const": 1 }, "error": { "type": "string", "minLength": 1, "maxLength": 500 }, "code": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" }, "field": { "type": "string", "maxLength": 200 } }
    }
  }
}
